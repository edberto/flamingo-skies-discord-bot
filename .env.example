# Copy to .env, fill in, then: chmod 600 .env
DISCORD_TOKEN=
GUILD_ID=
# Games as "Name:UniverseID", comma-separated. 0 = not published yet (placeholder).
# Universe ID: Creator Dashboard -> your experience -> Overview.
GAMES=Huss game:0
# Channel IDs (right-click a channel -> Copy Channel ID, with Developer Mode on)
STATUS_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
STATS_CHANNEL_ID=
# Open Cloud key with only universe-analytics -> universe.analytics:read on your games
ROBLOX_ANALYTICS_KEY=
# Hour (Asia/Jakarta) for the daily digest
DIGEST_HOUR=9
